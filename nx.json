{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "!{projectRoot}/.next/**/*", "!{projectRoot}/dist/**/*"],
    "production": ["default", "!{projectRoot}/tests/**/*"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/eslint.config.mjs", "{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/themes/**/*", "{workspaceRoot}/scripts/verify-public-theme.mjs"]
  },
  "targetDefaults": {
    "build": { "dependsOn": ["^build"], "inputs": ["production", "^production"], "cache": true },
    "typecheck": { "dependsOn": ["^build"], "inputs": ["default", "^production"], "cache": true },
    "lint": { "cache": true },
    "test": { "dependsOn": ["^build"], "cache": true }
  },
  "parallel": 2
}
