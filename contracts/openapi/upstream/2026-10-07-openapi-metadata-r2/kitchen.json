{
  "openapi": "3.1.1",
  "info": {
    "title": "Tiffin.Kitchen.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:6600/"
    }
  ],
  "paths": {
    "/v1/platform/status": {
      "get": {
        "tags": [
          "Tiffin.Kitchen.Api"
        ],
        "operationId": "GetPlatformStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/kitchen/tickets": {
      "get": {
        "tags": [
          "Kitchen"
        ],
        "operationId": "ListTickets",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfTicketView"
                }
              }
            }
          }
        }
      }
    },
    "/v1/kitchen/tickets/{orderId}/accept": {
      "post": {
        "tags": [
          "Kitchen"
        ],
        "operationId": "AcceptTicket",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketView"
                }
              }
            }
          }
        }
      }
    },
    "/v1/kitchen/tickets/{orderId}/reject": {
      "post": {
        "tags": [
          "Kitchen"
        ],
        "operationId": "RejectTicket",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptRequest": {
        "required": [
          "readyInMinutes"
        ],
        "type": "object",
        "properties": {
          "readyInMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PageOfTicketView": {
        "required": [
          "items",
          "number",
          "size",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketView"
            }
          },
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "pageCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "RejectRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "TicketLineView": {
        "required": [
          "code",
          "name",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "TicketView": {
        "required": [
          "orderId",
          "orderNumber",
          "restaurantId",
          "restaurantName",
          "status",
          "readyInMinutes",
          "reason",
          "receivedOnUtc",
          "decidedOnUtc",
          "lines"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderNumber": {
            "type": "string"
          },
          "restaurantId": {
            "type": "string",
            "format": "uuid"
          },
          "restaurantName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "readyInMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "receivedOnUtc": {
            "type": "string",
            "format": "date-time"
          },
          "decidedOnUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketLineView"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tiffin.Kitchen.Api"
    },
    {
      "name": "Kitchen"
    }
  ]
}
