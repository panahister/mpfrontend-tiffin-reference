{
  "openapi": "3.1.1",
  "info": {
    "title": "Tiffin.Ordering.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:6400/"
    }
  ],
  "paths": {
    "/v1/platform/status": {
      "get": {
        "tags": [
          "Tiffin.Ordering.Api"
        ],
        "operationId": "GetPlatformStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "PlaceOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderAccepted"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "ListMyOrders",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfOrderSummary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "GetOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}/cancel": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "CancelOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CancelRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelRequest": {
        "required": [
          "note"
        ],
        "type": "object",
        "properties": {
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OrderAccepted": {
        "required": [
          "orderId",
          "orderNumber",
          "total",
          "currency",
          "placedOnUtc"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderNumber": {
            "type": "string"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "placedOnUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderHistoryView": {
        "required": [
          "status",
          "occurredOnUtc",
          "note"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "occurredOnUtc": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OrderLineView": {
        "required": [
          "code",
          "name",
          "unitPrice",
          "quantity",
          "lineTotal"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "lineTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "OrderSummary": {
        "required": [
          "orderId",
          "orderNumber",
          "restaurantName",
          "status",
          "total",
          "currency",
          "placedOnUtc"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderNumber": {
            "type": "string"
          },
          "restaurantName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "placedOnUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderView": {
        "required": [
          "orderId",
          "orderNumber",
          "city",
          "status",
          "restaurantId",
          "restaurantName",
          "lines",
          "total",
          "currency",
          "district",
          "cancellationReason",
          "courierName",
          "readyInMinutes",
          "refunded",
          "placedOnUtc",
          "history"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderNumber": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "restaurantId": {
            "type": "string",
            "format": "uuid"
          },
          "restaurantName": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineView"
            }
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "cancellationReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "courierName": {
            "type": [
              "null",
              "string"
            ]
          },
          "readyInMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "refunded": {
            "type": "boolean"
          },
          "placedOnUtc": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderHistoryView"
            }
          }
        }
      },
      "PageOfOrderSummary": {
        "required": [
          "items",
          "number",
          "size",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            }
          },
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "pageCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "PlaceOrder": {
        "required": [
          "restaurantId",
          "lines",
          "deliverTo",
          "paymentToken",
          "expectedTotal"
        ],
        "type": "object",
        "properties": {
          "restaurantId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceOrderLine"
            }
          },
          "deliverTo": {
            "$ref": "#/components/schemas/PlaceOrderAddress"
          },
          "paymentToken": {
            "type": "string"
          },
          "expectedTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "PlaceOrderAddress": {
        "required": [
          "recipient",
          "phone",
          "district",
          "line"
        ],
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "line": {
            "type": "string"
          }
        }
      },
      "PlaceOrderLine": {
        "required": [
          "code",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tiffin.Ordering.Api"
    },
    {
      "name": "Orders"
    }
  ]
}
