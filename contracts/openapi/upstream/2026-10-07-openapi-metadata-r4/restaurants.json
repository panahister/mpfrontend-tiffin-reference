          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "isAvailable": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "pictureId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
