{
  "openapi": "3.1.1",
  "info": {
    "title": "Tiffin.Media.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:6200/"
    }
  ],
  "paths": {
    "/v1/platform/status": {
      "get": {
        "tags": [
          "Tiffin.Media.Api"
        ],
        "operationId": "GetPlatformStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/media/uploads": {
      "post": {
        "tags": [
          "Media"
        ],
        "operationId": "ReserveUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveUpload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadTicket"
                }
              }
            }
          }
        }
      }
    },
    "/v1/media/{mediaId}/confirm": {
      "post": {
        "tags": [
          "Media"
        ],
        "operationId": "ConfirmUpload",
        "parameters": [
          {
            "name": "mediaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaView"
                }
              }
            }
          }
        }
      }
    },
    "/v1/media/{mediaId}": {
      "get": {
        "tags": [
          "Media"
        ],
        "operationId": "GetMedia",
        "parameters": [
          {
            "name": "mediaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaView"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Media"
        ],
        "operationId": "DeleteMedia",
        "parameters": [
          {
            "name": "mediaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MediaView": {
        "required": [
          "mediaId",
          "city",
          "purpose",
          "fileName",
          "contentType",
          "size",
          "state",
          "reservedOnUtc",
          "availableOnUtc",
          "downloadUrl",
          "downloadUrlExpiresOnUtc"
        ],
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "city": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "state": {
            "type": "string"
          },
          "reservedOnUtc": {
            "type": "string",
            "format": "date-time"
          },
          "availableOnUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "downloadUrl": {
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          },
          "downloadUrlExpiresOnUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ReserveUpload": {
        "required": [
          "purpose",
          "fileName",
          "contentType",
          "size"
        ],
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "UploadTicket": {
        "required": [
          "mediaId",
          "uploadUrl",
          "method",
          "contentType",
          "size",
          "expiresOnUtc"
        ],
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadUrl": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "expiresOnUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tiffin.Media.Api"
    },
    {
      "name": "Media"
    }
  ]
}
