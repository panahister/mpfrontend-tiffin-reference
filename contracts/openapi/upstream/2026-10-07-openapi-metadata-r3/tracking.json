{
  "openapi": "3.1.1",
  "info": {
    "title": "Tiffin.Tracking.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:6800/"
    }
  ],
  "paths": {
    "/v1/platform/status": {
      "get": {
        "tags": [
          "Tiffin.Tracking.Api"
        ],
        "operationId": "GetPlatformStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/tracking/deliveries/{orderId}/positions": {
      "post": {
        "tags": [
          "Tracking"
        ],
        "operationId": "ReportPosition",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PositionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/tracking/deliveries/{orderId}": {
      "get": {
        "tags": [
          "Tracking"
        ],
        "operationId": "GetTracking",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "points",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackingView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PositionRequest": {
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "PositionView": {
        "required": [
          "latitude",
          "longitude",
          "recordedOnUtc"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "recordedOnUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrackingView": {
        "required": [
          "orderId",
          "orderNumber",
          "status",
          "lastSeen",
          "positionCount",
          "beganOnUtc",
          "arrivedOnUtc",
          "trail"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "lastSeen": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PositionView"
              }
            ]
          },
          "positionCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "beganOnUtc": {
            "type": "string",
            "format": "date-time"
          },
          "arrivedOnUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "trail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PositionView"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tiffin.Tracking.Api"
    },
    {
      "name": "Tracking"
    }
  ]
}
